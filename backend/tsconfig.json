{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",

    /* Project Structure */
    "rootDir": "src",
    "outDir": "dist",

    /* Type Safety */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Runtime Behavior */
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Dev Experience */
    "sourceMap": true,

    /* Types */
    "types": ["node", "express"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
